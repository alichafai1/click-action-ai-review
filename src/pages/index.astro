import BrowserMockup from '../components/mockups/BrowserMockup.astro';
import ExportMockup from '../components/mockups/ExportMockup.astro';
import { affiliateUrl } from '../lib/affiliate';

const problems = [
  'ChatGPT gives you a 7-step guide and leaves you to do the work.',
  'You’re stuck in the copy-paste marathon: open a site, copy, switch tabs, paste, repeat 100 times.',
  'You spend hours repeating the same manual clicks every single day.',
];

const features = [
  {
    title: 'Prompt-To-Done',
    text: 'It doesn’t just answer; it executes.',
    detail: 'One plain-language command starts the mission. The agent plans the steps instead of handing you a guide.',
    icon: 'prompt',
  },
  {
    title: 'Live Watch Screen',
    text: 'See every click and keystroke in real-time.',
    detail: 'The cloud browser stays on screen, with a checklist that ticks off as the job moves.',
    icon: 'watch',
  },
  {
    title: '50 Gig Missions',
    text: 'Pre-built tasks for lead gen, data entry, and research.',
    detail: 'These are ready-made jobs. Reference prices on a mission are suggestions for client work, not income you are owed.',
    icon: 'missions',
  },
  {
    title: 'Lead Finder Mode',
    text: 'Turn a niche + city into a fully exported list of prospects.',
    detail: 'Ask for the businesses, the city, and the fields you need. The export is the deliverable.',
    icon: 'leads',
  },
  {
    title: 'Pause & Take Over',
    text: 'Unlike other bots that break, it pauses when it hits a login or CAPTCHA.',
    detail: 'You step in for about 5 seconds, then it takes back over. It does not bypass the check.',
    icon: 'pause',
  },
  {
    title: 'Client-Ready Exports',
    text: 'Download to CSV, Google Sheets, or PDF.',
    detail: 'The point of the mission is a file you can use or send, not a chat transcript you still have to clean up.',
    icon: 'export',
  },
];

const pros = [
  'It actually executes browser tasks instead of stopping at advice.',
  'Live Watch gives you visual feedback while the mission runs.',
  'The front-end is a one-time price, not another monthly AI subscription.',
  'Lead Finder is built in, so a niche and a city can become an exported list.',
];

const cons = [
  'You still need to provide a good prompt. A vague request produces a vague mission.',
  'Some sites block automated browsers. Pause & Take Over helps on logins and CAPTCHAs, but it is not a bypass.',
  'It is not set-and-forget. You start the job, and you have to be there for the steps that need a human.',
];

const audiences = [
  {
    title: 'Marketers & Agencies',
    text: 'Scrape leads, fill out directories, and automate client research.',
  },
  {
    title: 'E-commerce Owners',
    text: 'Monitor competitor prices, gather product data, and automate outreach.',
  },
  {
    title: 'Freelancers',
    text: 'Automate the boring parts of data entry and research.',
  },
];

const faqs = [
  {
    question: 'What is Click Action AI?',
    answer:
      'Click Action AI is a prompt-to-done AI browser agent. You type the job in plain language. It opens a live cloud browser, clicks, types, and moves through the steps, then exports a finished file.',
  },
  {
    question: 'How is it different from ChatGPT?',
    answer:
      'ChatGPT gives you an answer or instructions. You still open the tabs, copy the data, and finish the job. Click Action AI is built to do that browser work and hand you the result.',
  },
  {
    question: 'Do I need to install any software?',
    answer:
      'No desktop app. The vendor describes a live cloud browser and a mobile dashboard, so you run missions from the account you receive after purchase. You need an internet connection.',
  },
  {
    question: 'Can it bypass CAPTCHAs?',
    answer:
      'No. It does not bypass CAPTCHAs or logins. When it hits one, Pause & Take Over stops the mission so you can complete that step yourself and hand the browser back.',
