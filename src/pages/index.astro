<script>
  const bar = document.querySelector('[data-sticky-cta]');
  const hero = document.querySelector('.hero');

  if (bar && hero) {
    const observer = new IntersectionObserver(([entry]) => {
      bar.classList.toggle('is-on', !entry.isIntersecting);
    });

    observer.observe(hero);
  }
</script>
