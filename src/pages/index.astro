  {
    question: 'Is there a money-back guarantee?',
    answer:
      'Check the JVZoo checkout. Refund rules are set by the vendor and shown on the order page before you pay. This review does not promise a specific number of days, because that term has to match the live cart.',
  },
  {
    question: 'How do I claim the bonuses?',
    answer:
      'Use a green button on this page, then follow the steps on the bonuses page. The files are emailed after the receipt is checked.',
  },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Click Action AI',
  description:
    'AI browser agent that opens a live browser, clicks, types, and executes tasks such as lead research and data entry.',
  brand: {
    '@type': 'Brand',
    name: 'Click Action AI',
  },
  url: 'https://clickactionai.info',
  image: 'https://clickactionai.info/favicon.svg',
  offers: {
    '@type': 'Offer',
    price: '36.95',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: affiliateUrl,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    bestRating: '5',
    worstRating: '1',
    ratingCount: 1,
  },
  review: {
    '@type': 'Review',
    author: {
      '@type': 'Organization',
      name: 'Click Action AI Review',
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: '4.7',
      bestRating: '5',
      worstRating: '1',
    },
    reviewBody:
      'This is not just another chatbot. It is an agent that does repetitive browser tasks while you watch, pause, and export the result. It still needs a clear prompt and a human for logins and CAPTCHAs.',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
