---
interface Props {
  value?: number;
}

const value = Astro.props.value ?? 4.7;
const uid = Math.random().toString(36).slice(2, 8);
const fills = [0, 1, 2, 3, 4].map((index) => Math.min(1, Math.max(0, value - index)));
---

<div class="stars" role="img" aria-label={`${value} out of 5 stars`}>
  {fills.map((fill, index) => (
    <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id={`star-${uid}-${index}`} x1="0" x2="1" y1="0" y2="0">
          <stop offset={`${fill * 100}%`} stop-color="#F5C518" />
          <stop offset={`${fill * 100}%`} stop-color="#3A3A3A" />
        </linearGradient>
      </defs>
      <path
        fill={`url(#star-${uid}-${index})`}
        d="M12 2.4l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 15.8 6.8 18.4l1-5.8L3.6 8.5l5.8-.8L12 2.4z"
      />
    </svg>
  ))}
</div>
