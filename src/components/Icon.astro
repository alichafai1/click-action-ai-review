---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
  {name === 'browser' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M3 9h18" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z" />
      <circle cx="12" cy="12" r="2.4" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="6" />
      <path d="M16 16l4 4" />
    </>
  )}
  {name === 'list' && (
    <>
      <path d="M9 6h11M9 12h11M9 18h11" />
      <path d="M4 6h.01M4 12h.01M4 18h.01" />
    </>
  )}
  {name === 'pause' && (
    <>
      <rect x="6" y="5" width="3.5" height="14" rx="1" fill="currentColor" stroke="none" />
      <rect x="14.5" y="5" width="3.5" height="14" rx="1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'download' && (
    <>
      <path d="M12 4v10" />
      <path d="M8 10l4 4 4-4" />
      <path d="M5 20h14" />
    </>
  )}
  {name === 'calculator' && (
    <>
      <rect x="5" y="3" width="14" height="18" rx="2" />
      <path d="M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3 19c1.2-2.6 3.2-4 6-4s4.8 1.4 6 4" />
      <circle cx="17" cy="9" r="2" />
      <path d="M17 13c2.2.3 3.6 1.4 4.4 3" />
    </>
  )}
  {name === 'bot' && (
    <>
      <rect x="5" y="8" width="14" height="10" rx="2" />
      <path d="M12 8V5M9 13h.01M15 13h.01M9 16h6" />
    </>
  )}
  {name === 'tag' && (
    <>
      <path d="M3 12V5h7l11 11-7 7L3 12z" />
      <circle cx="8" cy="8" r="1" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3l7 3v6c0 4.2-2.8 7.2-7 8.5C7.8 19.2 5 16.2 5 12V6l7-3z" />
      <path d="M9 12l2 2 4-4" />
    </>
  )}
  {name === 'file' && (
    <>
      <path d="M7 3h7l5 5v13H7z" />
      <path d="M14 3v5h5M9 13h6M9 17h6" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M4 7l8 6 8-6" />
    </>
  )}
  {name === 'receipt' && (
    <>
      <path d="M7 3h10v18l-2-1.5L13 21l-2-1.5L9 21l-2-1.5L5 21V3h2z" />
      <path d="M9 8h6M9 12h6" />
    </>
  )}
  {name === 'check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M8 12.5l2.5 2.5L16 9.5" />
    </>
  )}
  {name === 'alert' && (
    <>
      <path d="M12 4l8 14H4L12 4z" />
      <path d="M12 10v4M12 16.5h.01" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 8v5l3 2" />
    </>
  )}
  {name === 'cursor' && <path d="M6 4l12 8-5 .6 2.4 6-2.2.8-2.5-6.2L6 16.5 6 4z" fill="currentColor" stroke="none" />}
</svg>
